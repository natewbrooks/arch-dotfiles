// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 24, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 3, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/mode",
        "hyprland/scratchpad",
        "custom/media",
        "hyprland/window"
    ],
    "modules-center": [],
    "modules-right": [
        "custom/cava",
        "custom/record",
        "custom/record-pause",
        "custom/record-stop",
        "pulseaudio",
        "bluetooth",
        "custom/lighting",
        "battery",
        "power-profiles-daemon",
        "custom/vpn",
        "custom/claude",
        "custom/ledger",
        "clock",
        "custom/share",
        "custom/messages",
        "custom/messages-badge",
        "custom/notifications",
        "custom/notifications-badge",
        "tray",
        "custom/power"
    ],
    // Modules configuration
     "hyprland/workspaces": {
         "disable-scroll": true,
         "all-outputs": true,
         // Hide HDMI-A-1's split workspaces (11+). Laptop never exceeds 10.
         "ignore-workspaces": ["^(1[1-9]|[2-9][0-9])$"],
         "warp-on-scroll": false,
         "format": "{name}",
         "format-icons": {
             "1": "",
             "2": "",
             "3": "",
             "4": "",
             "5": "",
             "urgent": "",
             "focused": " ",
             "default": ""
         }
     },
    "keyboard-state": {
        "numlock": true,
        "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    "custom/share": {
        "format": "\uf1e0",
        "tooltip-format": "Share with phone / computer",
        "menu": "on-click",
        "menu-file": "$($HOME/.local/bin/kdeshare menu)",
        "menu-actions": {
            "open_received": "$HOME/.local/bin/kdeshare received",
            "phone_clip": "$HOME/.local/bin/kdeshare clipboard phone",
            "pc_clip": "$HOME/.local/bin/kdeshare clipboard pc",
            "phone_files": "$HOME/.local/bin/kdeshare files phone",
            "pc_files": "$HOME/.local/bin/kdeshare files pc",
            "phone_browse": "$HOME/.local/bin/kdeshare browse phone",
            "pc_browse": "$HOME/.local/bin/kdeshare browse pc"
        }
    },
    "custom/messages": {
        "format": "\uf4ad",
        "tooltip-format": "Messages",
        "on-click": "$HOME/.local/bin/messages toggle"
    },
    "custom/messages-badge": {
        "exec": "$HOME/.local/bin/messages watch",
        "return-type": "json",
        "on-click": "$HOME/.local/bin/messages toggle"
    },
    "custom/claude": {
        "exec": "$HOME/.config/waybar/claude.sh",
        "return-type": "json",
        "format": "{}",
        "tooltip": false,
        "restart-interval": 1,
        "on-click": "$HOME/.config/waybar/claude-menu.py",
        "on-scroll-up": "$HOME/.config/waybar/claude.sh next",
        "on-scroll-down": "$HOME/.config/waybar/claude.sh next"
    },
    "custom/cava": {
        "exec": "$HOME/.config/waybar/cava.sh",
        "format": "{}",
        "tooltip": false,
        "restart-interval": 1
    },
    "custom/record": {
        "exec": "$HOME/.local/bin/record-ctl status",
        "interval": 1,
        "return-type": "json",
        "signal": 10,
        "format": "{}",
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/record_menu.xml",
        "menu-actions": {
            "open_last": "$HOME/.local/bin/record-ctl open-last",
            "open_last_shot": "$HOME/.local/bin/record-ctl open-last-shot",
            "clip_toggle": "$HOME/.local/bin/record-ctl clip-toggle",
            "video_region": "$HOME/.local/bin/record-ctl start video region",
            "video_full": "$HOME/.local/bin/record-ctl start video full",
            "gif_region": "$HOME/.local/bin/record-ctl start gif region",
            "gif_full": "$HOME/.local/bin/record-ctl start gif full"
        }
    },
    "custom/record-pause": {
        "exec": "$HOME/.local/bin/record-ctl status pause",
        "interval": 1,
        "return-type": "json",
        "signal": 10,
        "format": "{}",
        "on-click": "$HOME/.local/bin/record-ctl pause"
    },
    "custom/record-stop": {
        "exec": "$HOME/.local/bin/record-ctl status stop",
        "interval": 1,
        "return-type": "json",
        "signal": 10,
        "format": "{}",
        "on-click": "$HOME/.local/bin/record-ctl stop"
    },
    "custom/vpn": {
        "exec": "$HOME/.config/waybar/vpn.sh",
        "interval": 3,
        "return-type": "json",
        "signal": 11,
        "format": "{}",
        "on-click": "$HOME/.config/waybar/vpn.sh toggle",
        "on-click-right": "$HOME/.config/waybar/vpn.sh check"
    },
    "custom/ledger": {
        "exec": "$HOME/.config/waybar/ledger-timer.sh",
        "interval": 1,
        "return-type": "json",
        "signal": 9,
        "format": "{}",
        "on-click": "$HOME/.config/waybar/claude-menu.py $HOME/.config/waybar/ledger-timer.sh ${XDG_RUNTIME_DIR:-/tmp}/ledger",
        "on-click-middle": "$HOME/.config/waybar/ledger-timer.sh toggle && pkill -RTMIN+9 waybar",
        "on-scroll-up": "$HOME/.config/waybar/ledger-timer.sh next && pkill -RTMIN+9 waybar",
        "on-scroll-down": "$HOME/.config/waybar/ledger-timer.sh next && pkill -RTMIN+9 waybar"
    },
    "custom/lighting": {
        "exec": "$HOME/.config/waybar/lighting.sh",
        "interval": 1,
        "return-type": "json",
        "format": "{}"
    },
    "custom/notifications-badge": {
        "exec": "$HOME/.local/bin/notifications-badge",
        "return-type": "json",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw"
    },
    "custom/notifications": {
        "exec": "swaync-client -swb 2>/dev/null",
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "notification":               "",
            "none":                       "",
            "dnd-notification":           "",
            "dnd-none":                   "",
            "inhibited-notification":     "",
            "inhibited-none":             "",
            "dnd-inhibited-notification": "",
            "dnd-inhibited-none":         ""
        },
        "tooltip-format": "Notifications",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
"hyprland/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "hyprland/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "mpd": {
        "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
        "format-disconnected": "Disconnected ",
        "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
        "unknown-tag": "N/A",
        "interval": 5,
        "consume-icons": {
            "on": " "
        },
        "random-icons": {
            "off": "<span color=\"#f53c3c\"></span> ",
            "on": " "
        },
        "repeat-icons": {
            "on": " "
        },
        "single-icons": {
            "on": "1 "
        },
        "state-icons": {
            "paused": "",
            "playing": ""
        },
        "tooltip-format": "MPD (connected)",
        "tooltip-format-disconnected": "MPD (disconnected)"
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "tray": {
        "icon-size": 14,
        "spacing": 10,
        "icons": {
         "blueman": "bluetooth",
         "TelegramDesktop": "$HOME/.local/share/icons/hicolor/16x16/apps/telegram.png"
        }
    },
    "clock": {
        "timezone": "America/New_York",
	    "tooltip-format": "<tt><big>{calendar}</big></tt>",
        "format-alt": "{:%m/%d/%Y}",
        "format": "{:%I:%M %p}",
        "calendar": {
            "mode"          : "month",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months":     "<span color='#dfdab7'>{}</span>",
                "days":       "<span color='#b084eb'>{}</span>",
                "weeks":      "<span color='#e99c29'>W{}</span>",
                "weekdays":   "<span color='#e99c29'>{}</span>",
                "today":      "<span color='#eddfffff'><b><u>{}</u></b></span>"
            }
        },
        "actions":  {
            "on-click-right": "mode",
            "on-scroll-up": "tz_up",
            "on-scroll-down": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{percent}% {icon}",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "states": {
            "good": 90,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% ",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        "format-time": "{H}hr {m}min",
        "interval": 30,
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "battery#bat2": {
        "bat": "BAT2"
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "{essid}<span font='10'> </span>",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} via {gwaddr} ",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "format-alt": "{ifname}: {ipaddr}/{cidr}",
        // "on-click": ""
    },
    "bluetooth": {
        "format-connected": " {device_alias} ",
        "format-on": " ",
        "format-off": "",
        "on-click": "blueman-manager"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon}",
        "format-muted": "",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "pulseaudio/slider": {
        "min": 0,
        "max": 100,
        "orientation": "horizontal"
    },
    "custom/media": {
        "format": "{icon} {text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "",
            "default": "🎜"
        },
        "escape": true,
        "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
        // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
    },
    "custom/power": {
        "format" : "",
        "exec": "$HOME/.config/waybar/sysinfo.sh", // hover tooltip = system stats
        "return-type": "json",
        "interval": 3,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
		"menu-actions": {
            "sysmon": "kitty -e htop",
            "logout": "fusermount -uz $HOME/dev/omcor; hyprctl dispatch exit", // lock omcor vault on logout
			"shutdown": "shutdown now",
			"reboot": "reboot",
			"suspend": "systemctl suspend",
			"hibernate": "systemctl hibernate"
		}
    },
    "custom/gamma": {
       "exec": "~/.local/bin/gamma-status",
       "interval": 1,
       "format": "{}% ",
       "tooltip-format": "{}% brightness"
    }
}
