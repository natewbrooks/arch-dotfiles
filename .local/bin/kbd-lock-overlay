#!/usr/bin/env python3
"""Persistent top-right 'Keyboard Locked' overlay anchored under waybar. Runs while locked, killed on unlock."""
import json
import os
import subprocess
import sys

# gtk4-layer-shell must load before libwayland - re-exec with LD_PRELOAD set.
_PRELOAD = "/usr/lib/libgtk4-layer-shell.so"
if _PRELOAD not in os.environ.get("LD_PRELOAD", ""):
    cur = os.environ.get("LD_PRELOAD", "")
    os.environ["LD_PRELOAD"] = f"{_PRELOAD}:{cur}" if cur else _PRELOAD
    os.execv(sys.executable, [sys.executable] + sys.argv)

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import GLib, Gtk, Gtk4LayerShell as LayerShell


def unlock_combo():
    """Read the bind that enters the kbdlock submap so the hint stays in sync with hyprland.conf."""
    try:
        binds = json.loads(subprocess.check_output(["hyprctl", "binds", "-j"], text=True))
    except Exception:
        return "META + \\"
    mod_names = {1: "SHIFT", 4: "CTRL", 8: "ALT", 64: "META"}
    key_names = {"backslash": "\\", "slash": "/", "bracketleft": "[", "bracketright": "]"}
    for b in binds:
        if b.get("submap") == "" and b.get("dispatcher") == "submap" and b.get("arg") == "kbdlock":
            mods = [name for bit, name in mod_names.items() if b.get("modmask", 0) & bit]
            key = b.get("key", "")
            key = key_names.get(key, key.upper() if len(key) == 1 else key)
            return " + ".join(mods + [key])
    return "META + \\"

CSS = b"""
window { background-color: transparent; }
.lock {
  background-color: #ff5555;
  color: #1a1a1a;
  font-weight: bold;
  font-size: 14px;
  padding: 6px 14px;
  border-radius: 8px;
  border: 2px solid #1a1a1a;
}
"""


def on_activate(app):
    win = Gtk.ApplicationWindow(application=app)
    LayerShell.init_for_window(win)
    LayerShell.set_layer(win, LayerShell.Layer.OVERLAY)  # above fullscreen
    LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.NONE)  # never grab input
    LayerShell.set_anchor(win, LayerShell.Edge.TOP, True)
    LayerShell.set_anchor(win, LayerShell.Edge.RIGHT, True)
    LayerShell.set_margin(win, LayerShell.Edge.TOP, 8)
    LayerShell.set_margin(win, LayerShell.Edge.RIGHT, 8)

    label = Gtk.Label()
    label.set_use_markup(True)
    label.set_justify(Gtk.Justification.LEFT)
    hint = GLib.markup_escape_text(unlock_combo())
    label.set_markup(f'🐱  <b>Keyboard Locked</b>\n<span size="x-small"><i>{hint} to unlock</i></span>')
    label.add_css_class("lock")
    win.set_child(label)

    css = Gtk.CssProvider()
    css.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_display(
        win.get_display(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )
    win.present()


app = Gtk.Application(application_id="cat.kbd.lock")
app.connect("activate", on_activate)
app.run(None)
